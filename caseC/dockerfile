FROM ubuntu:22.04

LABEL org.opencontainers.image.title="dockertest-casec" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.description="Test image for Case C vulnerability remediation" \
      org.opencontainers.image.base.name="ubuntu:22.04" \
      org.opencontainers.image.source="https://github.com/LucasChevrierGit/test-docker-file-remediation" \
      com.datadoghq.image.source_path="caseC/dockerfile"

RUN apt-get update && apt-get install -y \
    nginx \
    && rm -rf /var/lib/apt/lists/*
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
